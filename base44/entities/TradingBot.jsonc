{
  "name": "TradingBot",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Bot name"
    },
    "asset_symbol": {
      "type": "string",
      "description": "Asset this bot trades"
    },
    "asset_type": {
      "type": "string",
      "enum": [
        "stock",
        "crypto"
      ],
      "description": "Type of asset"
    },
    "strategy": {
      "type": "string",
      "enum": [
        "dca",
        "grid",
        "momentum",
        "mean_reversion"
      ],
      "description": "Trading strategy"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "paused",
        "stopped"
      ],
      "default": "paused",
      "description": "Bot status"
    },
    "budget": {
      "type": "number",
      "description": "Total budget allocated in USD"
    },
    "budget_used": {
      "type": "number",
      "default": 0,
      "description": "Budget already deployed"
    },
    "total_profit_loss": {
      "type": "number",
      "default": 0,
      "description": "Running P&L in USD"
    },
    "total_profit_loss_pct": {
      "type": "number",
      "default": 0,
      "description": "Running P&L percentage"
    },
    "trade_count": {
      "type": "number",
      "default": 0,
      "description": "Number of trades executed"
    },
    "stop_loss_pct": {
      "type": "number",
      "description": "Stop loss percentage"
    },
    "take_profit_pct": {
      "type": "number",
      "description": "Take profit percentage"
    },
    "frequency": {
      "type": "string",
      "enum": [
        "1m",
        "5m",
        "15m",
        "1h",
        "4h",
        "1d"
      ],
      "default": "1h",
      "description": "Trading frequency"
    },
    "last_signal": {
      "type": "string",
      "description": "Last signal generated by the bot"
    },
    "last_run": {
      "type": "string",
      "description": "ISO timestamp of the last bot run"
    },
    "last_trade_price": {
      "type": "number",
      "description": "Price at the last executed trade"
    }
  },
  "required": [
    "name",
    "asset_symbol",
    "strategy",
    "budget"
  ]
}