{
  "name": "PortfolioSnapshot",
  "type": "object",
  "properties": {
    "total_value": {
      "type": "number",
      "description": "Total portfolio value at the time of snapshot"
    },
    "timestamp": {
      "type": "string",
      "description": "ISO timestamp of when the snapshot was taken"
    }
  },
  "required": [
    "total_value",
    "timestamp"
  ]
}